{
  "name": "report-card-maker",
  "version": "1.0.0",
  "description": "Report Card Maker - Desktop App",
  "main": "main.js",
  "author": "Tamjed",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "dependencies": {
    "sql.js": "^1.10.3"
  },
 "devDependencies": {
  "electron": "^22.3.27",
  "electron-builder": "^24.13.3"
},
  "build": {
    "appId": "com.tamjed.reportcardmaker",
    "productName": "Report Card Maker",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
